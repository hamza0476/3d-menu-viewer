# Platera — environment variables
# Copy this file to ".env" for local development and fill in real values.
# NEVER commit a real .env file or paste real secrets into the repository.
# In production these are set in the hosting platform's environment settings.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. The app refuses to start without it.
# Local default below matches docker-compose.yml in this repo.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Email (verification + password reset, sent via Resend) ------------------
# Without RESEND_API_KEY, emails are logged to the server console instead of
# being sent — fine for local testing, NOT acceptable in production (accounts
# cannot verify or reset without real delivery).
RESEND_API_KEY=
# Sender address. Must be a domain verified in Resend for production use.
EMAIL_FROM=Platera <onboarding@resend.dev>

# --- Platform admin -----------------------------------------------------------
# Comma-separated email allowlist for the /admin moderation panel, e.g.
# ADMIN_EMAILS=you@example.com,ops@example.com
# Leave empty to disable /admin entirely (nobody can access it).
ADMIN_EMAILS=
