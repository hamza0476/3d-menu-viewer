# Platera — environment variables
# Copy this file to ".env" for local development and fill in real values.
# NEVER commit a real .env file or paste real secrets into the repository.
# In production these are set in the hosting platform's environment settings.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. The app refuses to start without it.
# Local default below matches docker-compose.yml in this repo.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Email (verification + password reset, sent via Resend) ------------------
# Without RESEND_API_KEY, emails are logged to the server console instead of
# being sent — fine for local testing, NOT acceptable in production (accounts
# cannot verify or reset without real delivery).
RESEND_API_KEY=
# Sender address. Must be a domain verified in Resend for production use.
EMAIL_FROM=Platera <onboarding@resend.dev>

# --- Media storage (Phase 2) ---------------------------------------------------
# Asset bytes live in object storage, never in the database. Set ALL FOUR R2
# variables to use Cloudflare R2 (S3-compatible, signed by hand — no SDK);
# leave them unset to use local disk (development/testing).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Local-disk storage root when R2 is not configured (default: ./.storage).
ASSET_STORAGE_DIR=
# Signs the short-lived preview URLs for private (unpublished) assets.
# REQUIRED in production — without it, a development fallback derives the
# secret from DATABASE_URL, which is acceptable only locally.
ASSET_SIGNING_SECRET=
# Optional malware-scan hook for uploads: POSTs the raw bytes to this URL
# (2xx = clean, 422/403 = infected, anything else = upload fails closed).
# Leave unset for no external scan — uploads are then protected by
# magic-byte validation + quarantine only. See docs/DECISIONS.md.
AV_SCAN_URL=

# --- Rate limiting (Upstash Redis) --------------------------------------------
# Leave unset for local development: auth rate limits then run in-memory
# (per process, reset on restart). REQUIRED for any multi-instance or
# serverless production deployment so limits are shared across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 ONLY when the app sits behind a proxy you control that sets
# x-forwarded-for / x-real-ip (they are ignored otherwise, because clients
# can spoof them). Cloudflare (cf-connecting-ip) and Vercel
# (x-vercel-forwarded-for) headers are always trusted — the platforms set
# and sanitise them.
TRUST_PROXY_HEADERS=

# --- Platform admin -----------------------------------------------------------
# Comma-separated email allowlist for the /admin moderation panel, e.g.
# ADMIN_EMAILS=you@example.com,ops@example.com
# Leave empty to disable /admin entirely (nobody can access it).
ADMIN_EMAILS=
